{
  "name": "brimmar/phpresult",
  "description": "Rust-like Option and Result types for PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.5"
  },
  "conflict": {
    "brimmar/phpoption": "*",
    "brimmar/phpstan-rustlike-option-extension": "<3.0",
    "brimmar/phpstan-rustlike-result-extension": "<3.0"
  },
  "autoload": {
    "psr-4": {
      "Brimmar\\PhpResult\\": "src/",
      "Brimmar\\PhpOption\\": "src/PhpOption/"
    }
  },
  "authors": [
    {
      "name": "Bryan",
      "email": "bryan.sergio@brimmar.dev"
    }
  ],
  "keywords": [
    "php",
    "result",
    "option",
    "rust",
    "monad",
    "functional",
    "error-handling"
  ],
  "support": {
    "issues": "https://github.com/brimmar/phpresult/issues",
    "source": "https://github.com/brimmar/phpresult"
  },
  "minimum-stability": "stable",
  "require-dev": {
    "pestphp/pest": "^4.0 || ^5.0",
    "phpstan/phpstan": "^2.3",
    "laravel/pint": "^1.26",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage",
    "analyse": "vendor/bin/phpstan analyse",
    "format": "vendor/bin/pint",
    "format:check": "vendor/bin/pint --test",
    "check": [
      "@format:check",
      "@analyse",
      "@test"
    ]
  }
}